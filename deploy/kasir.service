[Unit]
Description=KasirWarung gunicorn (internal port 8000)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=dana
Group=dana
WorkingDirectory=/home/dana/kasir
Environment=COOKIE_SECURE=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/dana/kasir/.venv/bin/gunicorn \
  --bind 127.0.0.1:8000 \
  --workers 2 --threads 2 --timeout 120 \
  --access-logfile /home/dana/kasir/logs/access.log \
  --error-logfile /home/dana/kasir/logs/error.log \
  app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
